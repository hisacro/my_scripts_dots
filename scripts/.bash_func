noks_display() { 
	adb devices
	adb tcpip 5434
	sleep 5
	adb connect 192.168.43.1:5434 
	echo "EEjit plug into wall socket fast"
	sleep 15
	scrcpy -b2M -m800 --max-fps 15
}

noks_hotspot() {
	adb shell am start -S com.android.settings/.TetherSettings
	adb shell input keyevent 20
	adb shell input keyevent 66
	adb shell am force-stop com.android.settings
}

noks_data() {
	adb shell input keyevent KEYCODE_MENU
	sleep 1
	adb shell input keyevent KEYCODE_MENU
	adb shell am start -a android.settings.DATA_ROAMING_SETTINGS
	sleep 1
	# when 2 sims are active s/600/700/g
	adb shell input tap 700 600 #advanced
	sleep 0.5
	adb shell input tap 700 600 #preffered network 
	sleep 0.5
	adb shell input tap 500 800 #2G 
	sleep 0.5
	adb shell input keyevent HOME
	adb shell am start -a android.settings.DATA_ROAMING_SETTINGS
	sleep 1
	adb shell input tap 700 600 #advanced
	sleep 0.5
	adb shell input tap 700 600 #preffered network 
	sleep 0.5
	adb shell input tap 500 600 #3G
	sleep 0.5
	adb shell input keyevent HOME
	adb shell am force-stop com.android.settings
}

dic() {
	# spell check and passing 1st recommendation
	word=$(echo "$1" | aspell -a | awk 'FNR == 2{print $5}'  | tr -d ',' )
	# if spelled right use that as word
	[[ $word == ''  ]] && word=$1 
	# meaning of it
	dictd --test $word 2> cat #suppress log
	# history of search
	grep $word ~/.dic_history > /dev/null || echo $word >> ~/.dic_history
}

