ts_feh () {
for i in $(ls); do
	tsp feh $i;
done
}

network () {
service  connman stop
service  NetworkManager start
}

finit() {
            fossil init $1.fossil && \
            chmod 644 $1.fossil && \
            fossil open $1.fossil && \
            fossil user password $USER $PASSWD && \
            fossil remote-url https://$USER:$PASSWD@fsl.displ.nl/$1 && \
            scp  $1.fossil bsdserver:/var/www/htdocs/fsl.displ.nl/  && \
            ssh bsdserver chmod 664 /var/www/htdocs/fsl.displ.nl/$1.fossil
            fossil ui
 }

ytdla () {
        yt-dlp -x --audio-format "opus" --yes-playlist "${1}" -o "%(title)s.%(ext)s"
}

ytdls () {
	ytdla `ytfzf -L "${1}"`
}

radio_down () {
	name=$(playerctl metadata "title")
        yt-dlp -x --audio-format "opus" --yes-playlist `ytfzf -L $name` -o "/home/hisacro/Music/radio/%(title)s.%(ext)s"
}

