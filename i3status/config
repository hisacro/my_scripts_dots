# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true 
        interval = 10
	output_format = "i3bar"
}

# order += "ipv6"
# order += "wireless _first_"
# order += "ethernet _first_"
# order += "playerctl"
order += "timer"
order += "pomodoro"
order += "battery all"
# order += "disk /"
order += "load"
order += "cpu_temperature 0"
order += "memory"
order += "tztime local"
order += "tztime Indian"
order += "tztime London"


# playerctl {
# 	color_bad = "#879dae"
# 	color_good = "#979dae"
# 	format_player = '[{title}]'
# }

timer {
	format = ' {timer} '
}

pomodoro {
	color_good = "#979dae"
	color_bad = "#879dae"
	format = " {mmss} {bar} "
	format_active = " {mmss} {bar} "
	format_stopped = " {mmss} {bar} "
	format_break = " Break #{breakno} {mmss} {bar} "
	format_break_stopped = " Break #{breakno} {bar} "
	sound_pomodoro_end = "/home/hisacro/.config/i3status/pomo_start.ogg" 
	sound_break_end = "/home/hisacro/.config/i3status/pomo_end.ogg"
}

wireless _first_ {
        format_up = "  %quality  "
        format_down = "  W:O  "
}

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

battery all {
	status_chr = "⚡"
	status_bat = " "
        # status_chr = "\\o/ ⚡"
	# status_bat = "/o\\"
	low_threshold=15
	threshold_type="percentage"
	format_percentage= "%.1f%s"
	format = ".. %percentage%status .. " 
}

disk "/" {
        format = "%avail"
}

load {
        format = "  %5min  "
}

cpu_temperature 0 {
	format = "  %degrees °C  "
	max_threshold = "85"
	format_above_threshold = "  READY TO TOAST  "
}
memory {
        format = "  %used  "
}

tztime local {
        format = "  %d-%m  "
}

tztime Indian {
	format = "  %H:%M  %Z "
        timezone = "Asia/Kolkata"
}


tztime London {
        format = " %H:%M:%S %Z "
        timezone = "Europe/London"
}
